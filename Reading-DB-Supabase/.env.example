# ===========================================================================
# Reading-DB-Supabase 环境变量
# 用于 scripts/verify_rls.py 做权限隔离自测
# .env 不要提交到版本库
# ===========================================================================

# Supabase 项目地址（本地栈用 http://127.0.0.1:54321）
SUPABASE_URL=http://127.0.0.1:54321

# publishable / anon 密钥 —— 前端同款，只能读已发布文章
SUPABASE_ANON_KEY=

# service_role 密钥 —— 只给后端，验证脚本需要它确认写权限正常
SUPABASE_SERVICE_ROLE_KEY=
