# ===========================================================================
# Reading-Material-Crawler-Service 环境变量
# 复制为 .env 后按需修改
# ===========================================================================

# --- Supabase（写入 source_log 走 service_role） --------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- SearXNG 元搜索 -------------------------------------------------------
# 默认指向共享栈 searxng-crawl4ai 提供的实例（127.0.0.1:8080）
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT=90
SEARXNG_CATEGORIES=news
SEARXNG_LANGUAGE=zh-CN
# 调用间隔（秒），PRD §4.2 限流：低频调用、禁止并发抓取
SEARXNG_MIN_INTERVAL=2

# --- Crawl4AI 网页清洗 ----------------------------------------------------
# auto    : 优先用本地 crawl4ai 库，其次 HTTP 服务，最后内置降级提取器
# library : 只用本地 crawl4ai 库
# http    : 只连 Crawl4AI HTTP 服务
CRAWLER_MODE=auto
CRAWLER_BASE_URL=http://127.0.0.1:11235
CRAWLER_TIMEOUT=120
# 清洗后正文最短字符数，低于该值直接丢弃（PRD §2.4）
CRAWLER_MIN_CONTENT_LENGTH=200
# Crawl4AI 容器的 Bearer 令牌。Crawl4AI 0.9.x 默认开启鉴权，没带对就是 401；
# 与共享栈 searxng-crawl4ai 的 CRAWL4AI_API_TOKEN 取同一个值（键名用 CRAWLER_ 前缀，跟本文件其它变量一致）。
CRAWLER_API_TOKEN=

# --- LLM 适配器 -----------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.3
LLM_THINK=false

# --- 服务自身 -------------------------------------------------------------
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8020
LOG_DIR=logs
CONFIG_DIR=config
# 素材查重指纹口径：summary | summary_level（同一梗概换难度算不同素材）
FINGERPRINT_MODE=summary
