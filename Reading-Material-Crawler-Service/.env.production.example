# ===========================================================================
# Reading-Material-Crawler-Service · 生产环境变量模板
#
# 用法：复制为 .env.production，按需修改；启动时加 APP_ENV=production 才会读它
#   $env:APP_ENV="production"
#   .\.venv\Scripts\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8020
# .env.production 已被 .gitignore 排除，不要提交到版本库。
#
# 与开发环境的差别：
#   LLM          Ollama 本机 → DeepSeek 云端（OpenAI 兼容接口）
#   Supabase     本地 Docker 栈 → 在线托管版
# ===========================================================================

# --- Supabase（在线托管版）------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role 密钥 —— 只放后端
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM 适配器：DeepSeek -------------------------------------------------
LLM_PROVIDER=openai
# DeepSeek 官方 base（OpenAI 兼容格式）；末尾加 /v1 也能用
LLM_BASE_URL=https://api.deepseek.com
# 官网现役模型：deepseek-flash / deepseek-v4-pro（旧的 deepseek-chat 已下线）
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.3
# 思考模式默认开着，梗概提炼这种结构化任务关掉更稳
LLM_THINK=false
# 单次响应输出上限，不给够 JSON 会被截断
LLM_MAX_TOKENS=4096

# --- SearXNG 元搜索 -------------------------------------------------------
# 生产环境建议把 deploy/docker-compose.yml 里的 searxng 一起部署到同一台主机
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT=30
SEARXNG_CATEGORIES=news
SEARXNG_LANGUAGE=zh-CN
SEARXNG_MIN_INTERVAL=2
# SearXNG 阶段的总时间预算（秒）：上游引擎全挂时提前切 RSS 兜底
SEARXNG_TOTAL_BUDGET=45

# --- RSS 直采兜底通道 -----------------------------------------------------
RSS_TIMEOUT=20
RSS_MIN_INTERVAL=1

# --- Crawl4AI 网页清洗 ----------------------------------------------------
CRAWLER_MODE=auto
CRAWLER_BASE_URL=http://127.0.0.1:11235
CRAWLER_TIMEOUT=120
CRAWLER_MIN_CONTENT_LENGTH=200

# --- 服务自身 -------------------------------------------------------------
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8020
LOG_DIR=logs
CONFIG_DIR=config
FINGERPRINT_MODE=summary
