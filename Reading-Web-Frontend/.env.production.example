# ===========================================================================
# Reading-Web-Frontend · 生产环境变量模板（GitHub Pages 构建时用）
#
# 这两个变量在「构建那一刻」被 Vite 编译进产物，所以要配成
# GitHub Actions 的 Secrets（仓库 → Settings → Secrets and variables → Actions）
#
# 只能用 publishable / anon 密钥 —— RLS 保证匿名角色只能读已发布文章，
# 读不到 source_log，也无法写入。service_role 绝不能出现在这里。
# ===========================================================================

# Supabase 在线托管版项目地址
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable（anon）密钥
VITE_SUPABASE_ANON_KEY=

# ===========================================================================
# 可选
# ===========================================================================

# 站点部署在子路径时的前缀：
#   GitHub Pages 普通项目页（https://<user>.github.io/<repo>/）→ 留空，
#     工作流会用仓库名自动推导成 /<repo>/
#   自定义域名（https://reading.example.com/）→ 填 /
#   部署在仓库根路径的用户页 → 填 /
VITE_BASE_PATH=
