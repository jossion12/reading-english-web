# =============================================================================
# Reading-English-Web · Git 忽略规则
#
# 重点：所有 .env 都不要进版本库（里面是 Supabase / DeepSeek 的真实密钥）
# =============================================================================

# --- 环境变量与密钥 ---------------------------------------------------------
.env
.env.*
!.env.example
!.env.production.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# --- 运行时产物 -------------------------------------------------------------
.runtime/
logs/
*.log

# --- Supabase CLI 本地状态 --------------------------------------------------
Reading-DB-Supabase/supabase/.branches/
Reading-DB-Supabase/supabase/.temp/

# --- 编辑器与系统 ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
