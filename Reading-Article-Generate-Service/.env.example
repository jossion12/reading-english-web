# ===========================================================================
# Reading-Article-Generate-Service 环境变量
# 复制为 .env 后按需修改；.env 不要提交到版本库
# ===========================================================================

# --- Supabase（本地栈：supabase status 可拿到 URL 与 key） ---------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM 适配器 -----------------------------------------------------------
# provider: ollama | openai
#   ollama -> 本机 Ollama（默认，离线免费）
#   openai -> 任何 OpenAI 兼容接口（MiniMax / OpenAI / vLLM / LM Studio）
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.7
# 思考型模型（qwen3 / qwen3.5）会输出 reasoning 段，结构化任务建议关闭
LLM_THINK=false

# --- 服务自身 -------------------------------------------------------------
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8010
LOG_DIR=logs
CONFIG_DIR=config
