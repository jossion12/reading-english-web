# ===========================================================================
# Reading-Article-Generate-Service · 生产环境变量模板
#
# 用法：复制为 .env.production，按需修改；启动时加 APP_ENV=production 才会读它
#   $env:APP_ENV="production"
#   .\.venv\Scripts\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8010
# .env.production 已被 .gitignore 排除，不要提交到版本库。
#
# 与开发环境的差别：
#   LLM          Ollama 本机 → DeepSeek 云端（OpenAI 兼容接口）
#   Supabase     本地 Docker 栈 → 在线托管版
# ===========================================================================

# --- Supabase（在线托管版）------------------------------------------------
# 项目地址在 Supabase 控制台 → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role 密钥 —— 有写库权限，只能放在后端，绝不能进前端或版本库
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM 适配器：DeepSeek -------------------------------------------------
# provider: ollama | openai
#   openai 模式兼容 DeepSeek / MiniMax / OpenAI / vLLM / LM Studio 等
LLM_PROVIDER=openai
# DeepSeek 官方 base（OpenAI 兼容格式）：https://api.deepseek.com
#   末尾加 /v1 也能用，但以官网写法为准更省心
LLM_BASE_URL=https://api.deepseek.com
# 官网现役模型：deepseek-flash（DeepSeek-V4.1-Flash-1017）/ deepseek-v4-pro
#   旧的 deepseek-chat 已不在现行模型列表里，别用
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 云端模型比本机小模型慢，超时给足
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.3
# DeepSeek 的思考模式默认是开的；结构化任务关掉更稳更快更便宜
#   改成 true 则让模型先思考再回答（更贵更慢）
LLM_THINK=false
# 单次响应输出上限 —— 不给够的话 JSON 会被截断成空内容
LLM_MAX_TOKENS=4096

# --- 服务自身 -------------------------------------------------------------
# 生产环境绑定内网地址；若要通过反向代理对外，容器监听 0.0.0.0 并在代理层做鉴权
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8010
LOG_DIR=logs
CONFIG_DIR=config
